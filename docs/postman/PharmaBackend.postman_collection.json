{
  "info": {
    "name": "PharmaBackend S14 Autónoma",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato ejecutable para el laboratorio H2 de tools/iniciar-e2e.ps1. Incluye una venta real de una unidad en memoria. No ejecutar sobre Oracle. Las claves se suministran localmente; no exportar tokens."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080/api/v1",
      "type": "string"
    },
    {
      "key": "usuarioAdmin",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "claveAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuarioVendedor",
      "value": "vendedor",
      "type": "string"
    },
    {
      "key": "claveVendedor",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenVendedor",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.variables.get('baseUrl') !== 'http://localhost:18080/api/v1') throw new Error('Esta colección modifica datos: usar exclusivamente el laboratorio H2 en 18080.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{usuarioAdmin}}\", \"password\": \"{{claveAdmin}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login Vendedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{usuarioVendedor}}\", \"password\": \"{{claveVendedor}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenVendedor', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos paginados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/productos?pagina=0&tamanio=20",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const p=pm.response.json(); pm.test('Página limitada',()=>pm.expect(p.contenido.length).to.be.at.most(20)); pm.collectionVariables.set('productoId',p.contenido[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Clientes disponibles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/clientes?pagina=0&tamanio=20",
