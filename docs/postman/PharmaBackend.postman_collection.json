      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('clienteId',pm.response.json().contenido[0].id);"
            ]
          }
        }
      ]
    },
