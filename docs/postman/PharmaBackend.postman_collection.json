    {
      "name": "Registrar venta H2 de una unidad",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ventas",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"clienteId\": \"{{clienteId}}\", \"detalles\": [{\"productoId\": \"{{productoId}}\", \"cantidad\": 1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const v=pm.response.json(); pm.collectionVariables.set('ventaId',v.id); pm.collectionVariables.set('requestIdVenta',pm.response.headers.get('X-Request-Id')); pm.test('Venta con creador',()=>pm.expect(v.creadoPor).to.eql(pm.variables.get('usuarioAdmin')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Venta confirmada en bitácora",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auditoria?accion=VENTA_REGISTRADA&tamanio=100",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const id=Number(pm.collectionVariables.get('ventaId')); const e=pm.response.json().contenido.find(e=>e.entidadId===id); pm.test('Correlación de venta',()=>{pm.expect(e).to.exist; pm.expect(e.requestId).to.eql(pm.collectionVariables.get('requestIdVenta'));});"
            ]
          }
        }
      ]
